#!/sbin/sh

umask 022

ui_print() { echo "$1"; }

require_new_sukisu() {
  ui_print "*******************************"
  ui_print " Please install sukisu v20.4+! "
  ui_print "*******************************"
  exit 1
}

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/sukisu/util_functions.sh ] || require_new_sukisu
. /data/adb/sukisu/util_functions.sh
[ $SUKISU_VER_CODE -lt 20400 ] && require_new_sukisu

install_module
exit 0
